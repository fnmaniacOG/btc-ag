# ─────────────────────────────────────────────────────────────────────────────
# btc.ag configuration
#
# Copy to .env.local for local dev. For the public site, set these in
# Vercel → Settings → Environment Variables. See DEPLOY.md for the walkthrough.
#
# btc.ag runs with ZERO keys — the four public venues (Ordinals Wallet,
# Odin.fun, Gamma, Nexus) work immediately. Each key lights up another venue.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site ──────────────────────────────────────────────────────────────

# Canonical origin. Drives canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://btc.ag

# ── Shared cache — REQUIRED IN PRODUCTION ────────────────────────────────────
#
# Without this, every serverless instance keeps a private cache and your
# marketplace API quota burns in proportion to traffic. With it, one nine-venue
# fan-out serves every visitor on every instance.
#
# Easiest path: Vercel → Storage → Create → Upstash Redis. That injects
# KV_REST_API_URL / KV_REST_API_TOKEN automatically and btc.ag picks them up.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_TIMEOUT_MS=2000

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per IP, per window. Every visitor request can fan out to nine marketplaces on
# YOUR keys, so these are what stop one scraper burning a monthly quota.

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LISTINGS=40
RATE_LIMIT_LIGHT=120
RATE_LIMIT_BUY=12

# ── Cron ─────────────────────────────────────────────────────────────────────
# Protects /api/cron/refresh, which warms the cache and renews the ORD.NET
# token. Vercel Cron sends this as a bearer token automatically.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Keyed venues ─────────────────────────────────────────────────────────────

# UniSat — ordinals, runes, BRC-20.
# Get a key: https://docs.unisat.io/developer-support/how-to-acquire-a-unisat-api-key
UNISAT_API_KEY=

# Magisat — the deepest rare-sat order book.
# Docs + key: https://magisat.io/docs/api/v1
MAGISAT_API_KEY=

# Satflow — ordinals, runes, rare sats. Also surfaces listings it has indexed
# from other venues, which is why it materially widens coverage.
# Request a key in the Satflow Discord: https://discord.gg/satflow
SATFLOW_API_KEY=

# ORD.NET — wallet-authenticated. There are NO API keys.
#
# A wallet BIP-322 signs a challenge and receives a bearer token valid for ONE
# HOUR, and the signing payment address must hold >= 0.01 BTC confirmed. For a
# site that runs unattended, btc.ag re-signs automatically — which means a
# private key lives here.
#
#   !! HOT KEY !!  Use a wallet created solely for this, holding a little over
#   0.01 BTC and nothing else. Never reuse a wallet that holds inscriptions,
#   runes, or savings. Leaving this unset is fully supported — ORD.NET simply
#   shows as unconfigured and the other eight venues carry on.
#
# Generate one:  npm run ordnet -- --generate
# Then verify:   npm run ordnet -- --test
ORDNET_SIGNING_WIF=

# Alternative: paste a token obtained manually. Works, but dies within an hour,
# so it is only useful for local testing.
ORDNET_TOKEN=

# Optional keys — these venues work without one, a key just raises rate limits.
GAMMA_API_KEY=
WECSATS_API_KEY=
NEXUS_API_KEY=

# ── Bitcoin chain data ───────────────────────────────────────────────────────

# Point this at your own mempool.space instance to remove the last third-party
# dependency for chain data.
MEMPOOL_BASE=https://mempool.space/api

# An `ord` server. Set this and the portfolio view resolves real sat ranges per
# UTXO, so rarity is computed from the chain rather than guessed.
# e.g. ORD_BASE=http://127.0.0.1:80
ORD_BASE=

# ── Tuning ───────────────────────────────────────────────────────────────────

CACHE_TTL_MS=20000          # how long an aggregated page is reused
CHAIN_CACHE_TTL_MS=15000
SOURCE_TIMEOUT_MS=9000      # hard ceiling per upstream call
DEFAULT_DEPTH=50            # listings pulled per venue by default
MAX_DEPTH=200
SOURCE_CONCURRENCY=9        # 9 = fan out to every venue at once
USER_AGENT=btc.ag/1.0 (+https://btc.ag)

# ── Per-venue toggles ────────────────────────────────────────────────────────
# Set any to false to drop a venue entirely.

UNISAT_ENABLED=true
MAGISAT_ENABLED=true
SATFLOW_ENABLED=true
GAMMA_ENABLED=true
ORDINALSWALLET_ENABLED=true
ORDNET_ENABLED=true
ODIN_ENABLED=true
WECSATS_ENABLED=true
NEXUS_ENABLED=true

# ── Endpoint overrides ───────────────────────────────────────────────────────
# Gamma, wecsats and Nexus do not publish API references. If any of them moves
# a route, re-point it here instead of editing code.

# GAMMA_BASE=https://gamma.io/api/v1
# GAMMA_LISTINGS_PATH=/ordinals/listings
# WECSATS_BASE=https://wecsats.com/api
# WECSATS_LISTINGS_PATH=/listings
# NEXUS_BASE=https://api.dotswap.app/api/v1
# NEXUS_POOLS_PATH=/pool/list

# Ordinals Wallet has no global order book — its API is per-collection, so we
# sweep this list. Add slugs to widen coverage.
# ORDINALSWALLET_COLLECTIONS=bitcoin-puppets,nodemonkes,quantum_cats,runestone

# CORS_ORIGIN=https://btc.ag
